    <!-- Pairing with the phone (through the server, also outside the own Wi-Fi) -->
    <string name="tv_pair_heading">Pair with your phone</string>
    <string name="tv_pair_lead">Your phone with GateControl does the sign-in. Nothing to type on the TV.</string>
    <string name="tv_pair_step1">Open GateControl on the phone: Settings › “Pair a TV”</string>
    <string name="tv_pair_step2">Scan the QR code on the right or type the code next to it</string>
    <string name="tv_pair_step3">Tap “Pair” on the phone. The TV then fetches its setup from the server and sets up the VPN by itself</string>
