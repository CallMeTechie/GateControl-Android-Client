<?xml version="1.0" encoding="utf-8"?>
<paths>
    <!-- Only the log export directory is shareable; the raw logs in
         cacheDir/logs and everything else in the cache stay private. -->
    <cache-path name="export" path="export/" />
    <!-- Chats: a downloaded chat file the person opens or shares, copied
         here under its own name (cacheDir/chat-open, pruned after a day).
         The downloaded chat files themselves stay private. -->
    <cache-path name="chat_open" path="chat-open/" />
    <!-- Chats: a photo taken with the camera app for a chat or a group
         picture (cacheDir/camera, pruned after a day). The camera app gets
         write access to the one file for the capture only. -->
    <cache-path name="camera" path="camera/" />
    <!-- School messages: an attachment the person opens or shares
         (cacheDir/school/<message>_<attachment>/<name>, removed after a
         week without use). -->
    <cache-path name="school" path="school/" />
    <!-- Drive: a downloaded file the person opens or sends
         (cacheDir/drive-open/<node>-r<rev>/<name>, pruned after a day). The
         upload copies in cacheDir/drive-up stay private. A copy of
         "Offline verfügbar" (filesDir/drive-offline, never shared itself) is
         handed out here as a link or copy of the one file. -->
    <cache-path name="drive_open" path="drive-open/" />
    <!-- Drive vaults: nothing. A vault file is never decrypted into a file;
         the viewer keeps it in memory, "Mit anderer App öffnen" hands out a
         memory file through DriveVaultShareProvider (Drive plugin 1.22). -->
    <!-- Mail: an attachment the person opens or shares
         (cacheDir/mail-open/<message>-<attachment>/<name>, pruned after a
         day, removed with Mail's offline copy). Uploads in cacheDir/mail-up
         stay private. -->
    <cache-path name="mail_open" path="mail-open/" />
    <!-- Notizen & Aufgaben: an attachment of a task or note the person opens
         (cacheDir/notizen-open/<name>, one file at a time, replaced by the next).
         Tresor attachments are never written here: they stay in memory. -->
    <cache-path name="notizen_open" path="notizen-open/" />
    <!-- Tür & Kamera: a still of a home camera the person shares
         ("Standbild › Teilen"; cacheDir/camera-still, one file at a time,
         removed with the door screen). -->
    <cache-path name="camera_still" path="camera-still/" />
    <!-- App update of the GitHub build: the downloaded and checked APK
         (cacheDir/update/update.apk), handed to Android's installer only. -->
    <cache-path name="update" path="update/" />
</paths>
