<?xml version="1.0" encoding="utf-8"?>
<paths>
    <!-- Only the log export directory is shareable; the raw logs in
         cacheDir/logs and everything else in the cache stay private. -->
    <cache-path name="export" path="export/" />
    <!-- Chats: a downloaded chat file the person opens or shares, copied
         here under its own name (cacheDir/chat-open, pruned after a day).
         The downloaded chat files themselves stay private. -->
    <cache-path name="chat_open" path="chat-open/" />
    <!-- Chats: a photo taken with the camera app for a chat or a group
         picture (cacheDir/camera, pruned after a day). The camera app gets
         write access to the one file for the capture only. -->
    <cache-path name="camera" path="camera/" />
    <!-- School messages: an attachment the person opens or shares
         (cacheDir/school/<message>_<attachment>/<name>, removed after a
         week without use). -->
    <cache-path name="school" path="school/" />
</paths>
