    <string name="drive_pp_people_switch">Recognise people</string>
    <string name="drive_pp_people_switch_desc">Find faces in your photos so you can search for people.</string>
    <string name="drive_pp_how">How it works</string>
    <string name="drive_pp_how_1">The phone recognises the faces itself, on Wi-Fi and while charging.</string>
    <string name="drive_pp_how_2">Only face features (numbers) reach your server, no pictures go to third parties.</string>
    <string name="drive_pp_how_3">Only you see your people and names.</string>
    <string name="drive_pp_how_5">When switched on, the phone loads the recognition model (39 MB) once from GitHub, else from Hugging Face – no photo goes with it.</string>
    <string name="drive_pp_how_4">Switching off deletes all face data.</string>
    <string name="drive_pp_charging">Only while charging</string>
    <string name="drive_pp_charging_desc">The first recognition of many photos needs battery – this way it runs at night. Applies to this phone.</string>
    <string name="drive_pp_kids">Include the children’s folders</string>
    <string name="drive_pp_kids_desc">Photos in the children’s folders. Default: off.</string>
    <string name="drive_pp_delete_faces">Delete all face data</string>
    <string name="drive_pp_delete_faces_desc">Names, groups and features – the photos stay. Switches “Recognise people” off.</string>
    <string name="drive_pp_off_title">Delete face data?</string>
    <string name="drive_pp_off_text">“Recognise people” is switched off and your server deletes all faces, people and names. The photos stay.</string>
    <string name="drive_pp_off_go">Switch off and delete</string>
    <string name="drive_pp_faces_deleted">Face data deleted.</string>
    <string name="drive_pp_licenses">Face recognition on the phone with YuNet (MIT licence) and SFace (Apache License 2.0) from OpenCV Zoo, run with ONNX Runtime (MIT licence).</string>
    <string name="drive_pp_model_loading">Loading the recognition model · %1$s of %2$s MB</string>
