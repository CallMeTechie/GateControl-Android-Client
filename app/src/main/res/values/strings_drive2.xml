    <!-- Folder backup -->
    <string name="drive_folders_title">Back up folders</string>
    <string name="drive_folders_intro">Folders of the phone – like WhatsApp media, downloads or documents – go to Drive. New and changed files are uploaded, sub folders are kept. What you delete on the phone stays in Drive for 30 more days, then goes to the trash.</string>
    <string name="drive_folders_intro_keep">Folders of the phone – like WhatsApp media, downloads or documents – go to Drive. New and changed files are uploaded, sub folders are kept. What you delete on the phone stays in Drive.</string>
    <string name="drive_folders_note">One way only: changes in Drive do not come to the phone. Hidden files (names starting with a dot) and temporary files are left out.</string>
    <string name="drive_folders_empty">No folder yet. Add one.</string>
    <string name="drive_folders_add">Add folder</string>
    <string name="drive_folders_added">Folder added – the backup starts.</string>
