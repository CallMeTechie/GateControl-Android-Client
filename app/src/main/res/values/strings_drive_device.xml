<!-- Drive › "On this device": the phone's own files (DriveDevice*.kt, drive/device) -->
<resources>
    <string name="drive_dev_title">On this device</string>
    <string name="drive_dev_open">On this device: the files of this phone</string>

    <!-- First visit: all files access -->
    <string name="drive_dev_access_title">The files on your phone in Drive</string>
    <string name="drive_dev_access_text">To show downloads, documents, SD cards and USB sticks, Drive needs Android\'s access to all files.</string>
    <string name="drive_dev_access_stays_title">Stays on the phone</string>
    <string name="drive_dev_access_stays">Drive uploads nothing you do not save yourself with "In Drive".</string>
    <string name="drive_dev_access_revoke_title">Revoke at any time</string>
    <string name="drive_dev_access_revoke">In Android\'s settings under Apps › GateControl › Permissions.</string>
    <string name="drive_dev_access_without_title">Without access</string>
    <string name="drive_dev_access_without">The photo and video backup and Drive itself keep working as before.</string>
    <string name="drive_dev_access_allow">Allow access</string>
    <string name="drive_dev_access_later">Not now</string>
    <string name="drive_dev_access_none">Android did not open the setting. Allow it under Settings › Apps › GateControl › All files access.</string>
    <string name="drive_dev_access_play_title">Not yet possible in the Google Play version</string>
    <string name="drive_dev_access_play">Google Play allows access to all files only after a review. Until then this page is only in the version from GitHub. Drive itself works as before.</string>
    <string name="drive_dev_access_back">Back to Drive</string>

