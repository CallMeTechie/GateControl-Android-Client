    <!-- Erster Aufruf: Zugriff auf alle Dateien -->
    <string name="drive_dev_access_title">Die Dateien auf deinem Handy in Drive</string>
    <string name="drive_dev_access_text">Damit Drive Downloads, Dokumente, SD-Karte und USB-Sticks zeigen kann, braucht es von Android den Zugriff auf alle Dateien.</string>
    <string name="drive_dev_access_stays_title">Bleibt auf dem Handy</string>
    <string name="drive_dev_access_stays">Drive lädt nichts hoch, was du nicht selbst mit „In Drive“ sicherst.</string>
    <string name="drive_dev_access_revoke_title">Jederzeit widerrufbar</string>
    <string name="drive_dev_access_revoke">In den Android-Einstellungen unter Apps › GateControl › Berechtigungen.</string>
    <string name="drive_dev_access_without_title">Ohne Zugriff</string>
    <string name="drive_dev_access_without">Die Fotos- und Video-Sicherung und Drive selbst funktionieren weiter wie bisher.</string>
    <string name="drive_dev_access_allow">Zugriff erlauben</string>
    <string name="drive_dev_access_later">Nicht jetzt</string>
    <string name="drive_dev_access_none">Android hat die Einstellung nicht geöffnet. Erlaube den Zugriff unter Einstellungen › Apps › GateControl › Zugriff auf alle Dateien.</string>
    <string name="drive_dev_access_play_title">In der Version aus Google Play noch nicht möglich</string>
    <string name="drive_dev_access_play">Google Play gibt den Zugriff auf alle Dateien erst nach einer Prüfung frei. Bis dahin gibt es diese Seite nur in der Version von GitHub. Drive selbst funktioniert wie bisher.</string>
    <string name="drive_dev_access_back">Zurück zu Drive</string>

