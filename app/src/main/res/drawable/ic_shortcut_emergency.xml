<?xml version="1.0" encoding="utf-8"?>
<!-- App shortcut icon of the Familie emergency card: white cross on red. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="#B91C1C" />
            <size android:width="48dp" android:height="48dp" />
        </shape>
    </item>
    <item
        android:drawable="@drawable/ic_shortcut_emergency_glyph"
        android:bottom="12dp"
        android:left="12dp"
        android:right="12dp"
        android:top="12dp" />
</layer-list>
