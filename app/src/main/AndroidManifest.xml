<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Chats: live arrival (Messenger 1.4) shares the position while the
         person drives, started by them from the open chat. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <!-- GateDrop: sending and receiving files (upload, download, direct LAN
         transfer) run in WorkManager's foreground service with a progress
         notification, started by the person (share sheet, "Speichern") or
         by a GateDrop push. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Chats (messenger plugin): voice messages, recorded only while the
         person holds the microphone button in a chat. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Notification center: "GateControl ausnehmen" asks to be exempted from
         battery optimisation so the push connection survives Doze. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Trusted WLANs by name (SSID): Android only reveals the WLAN name with
         a location permission, in the background only with "Allow all the
         time". Requested only when the user adds a WLAN name; the app never
         uses the location itself. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <!-- Vault: "WLAN in der Nähe" lists the WLANs in range when adding a WLAN
         entry (scan results need the location permission above, asked only
         then). -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />

    <!-- Query all launchable apps for split-tunnel app picker -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- Recommended split-tunnel exclusions (no launcher activity) -->
        <package android:name="com.google.android.projection.gearhead" />
    </queries>

    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <application
        android:name=".GateControlApp"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.GateControl"
        tools:replace="android:theme">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.GateControl">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="gatecontrol"
                    android:host="setup" />
                <data
                    android:scheme="gatecontrol"
                    android:host="enroll" />
            </intent-filter>
            <!-- Chats: share target of the sharing shortcuts (one per recent
                 conversation, published at runtime by ChatShortcuts). -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- Browser answer of "Mit Microsoft anmelden" (gatecontrol://signin):
             forwarded to the running MainActivity, closing the Custom Tab. -->
        <activity
            android:name=".SigninRedirectActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@style/Theme.GateControl.TileAction">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="gatecontrol"
                    android:host="signin" />
            </intent-filter>
        </activity>

        <!-- Performs Quick Settings tile actions (connect incl. VPN consent,
             disconnect). NOT exported: other apps must not be able to
             toggle the VPN. -->
        <activity
            android:name=".service.TileActionActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@style/Theme.GateControl.TileAction" />

        <service
            android:name=".service.VpnTileService"
            android:icon="@drawable/ic_vpn_tile"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Home-screen widget (VPN state, connect/disconnect, unread messages) -->
        <receiver
            android:name=".widget.VpnWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/vpn_widget_info" />
        </receiver>

        <!-- Home-screen widget with the pinned quick actions of the plugins -->
        <receiver
            android:name=".quickactions.QuickActionsWidgetReceiver"
            android:exported="true"
            android:label="@string/quick_actions_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/quick_actions_widget_info" />
        </receiver>

        <!-- Runs one quick action (app shortcut, widget, tile). NOT exported:
             only this app's shortcuts and pending intents can start it. -->
        <activity
            android:name=".quickactions.QuickActionActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@style/Theme.GateControl.TileAction" />

        <service
            android:name=".quickactions.QuickActionTile1"
            android:icon="@drawable/ic_quick_action"
            android:label="@string/quick_action_tile_1"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name=".quickactions.QuickActionTile2"
            android:icon="@drawable/ic_quick_action"
            android:label="@string/quick_action_tile_2"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name=".quickactions.QuickActionTile3"
            android:icon="@drawable/ic_quick_action"
            android:label="@string/quick_action_tile_3"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <receiver
            android:name=".receiver.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <activity
            android:name=".rdp.RdpSessionActivity"
            android:exported="false"
            android:theme="@style/Theme.GateControl"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden"
            android:windowSoftInputMode="adjustResize" />

        <service
            android:name=".service.RdpSessionService"
            android:foregroundServiceType="specialUse"
            android:exported="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps a user-started remote desktop (RDP) session connected while the session screen is in the background." />
        </service>

        <!-- Notification center (mode "always"): holds the push connection
             to the user's own server. Started only by the app itself. -->
        <service
            android:name=".push.PushService"
            android:foregroundServiceType="specialUse"
            android:exported="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps a persistent connection to the user's own GateControl server to receive notifications without Google services (no FCM)." />
        </service>

        <!-- Chats: live arrival (Messenger 1.4) — position at most every 20 s
             while an own arrival is live, with an ongoing notification. Started
             only by the app itself, while visible. -->
        <service
            android:name=".chat.ChatArrivalService"
            android:foregroundServiceType="location"
            android:exported="false" />

        <!-- Notification buttons and swipe-away of push messages. NOT exported:
             only the app's own PendingIntents reach it. -->
        <receiver
            android:name=".push.PushActionReceiver"
            android:exported="false" />

        <!-- Opens a tapped push message (detail, app route, portal). NOT
             exported, so MainActivity keeps acting on no intent extras. -->
        <activity
            android:name=".push.PushOpenActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@style/Theme.GateControl.TileAction" />

        <!-- Familie: buttons of Familie notifications (send / decline the
             location, task done, accept a place reminder, SOS seen). NOT
             exported: only the app's own PendingIntents reach it. -->
        <receiver
            android:name=".familie.push.FamilieActionReceiver"
            android:exported="false" />

        <!-- Familie: geofence transitions of place reminders, delivered by
             Play services through the app's own PendingIntent. NOT exported. -->
        <receiver
            android:name=".familie.places.GeofenceReceiver"
            android:exported="false" />

        <!-- Familie: opens a screen of the Familie tab from the app's own
             notifications. NOT exported. -->
        <activity
            android:name=".familie.push.FamilieOpenActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@style/Theme.GateControl.TileAction" />

        <!-- Familie: "Standort senden" from a locate notification when the app
             may not locate in the background (locates while visible). NOT exported. -->
        <activity
            android:name=".familie.push.FamilieLocateActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@style/Theme.GateControl.TileAction" />

        <!-- Chats: buttons of chat notifications (inline answer, mark as
             read, swipe away). NOT exported: only the app's own
             PendingIntents reach it. -->
        <receiver
            android:name=".chat.ChatActionReceiver"
            android:exported="false" />

        <!-- Share target "Teilen → GateControl" (text, pictures, files):
             the GateDrop sheet when the server offers GateDrop, else the
             chats. Exported for the system's share sheet, but disabled
             until the server offers the chats or GateDrop
             (ChatShareActivity.setEnabled). Reads only content:// URIs of
             other apps, never file:// or the app's own providers. -->
        <activity
            android:name=".chat.ChatShareActivity"
            android:exported="true"
            android:enabled="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:label="@string/share_target_label"
            android:theme="@style/Theme.GateControl.TileAction">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <!-- Chats: content of a chat bubble (BubbleMetadata of the chat
             notifications). NOT exported: only the app's own bubble
             PendingIntent starts it. Embedded and resizable as bubbles need. -->
        <activity
            android:name=".chat.ChatBubbleActivity"
            android:exported="false"
            android:allowEmbedded="true"
            android:resizeableActivity="true"
            android:documentLaunchMode="always"
            android:label="@string/chat_title"
            android:theme="@style/Theme.GateControl"
            android:windowSoftInputMode="adjustResize" />

        <!-- Vault: Android's autofill service (fills logins from Vault in other
             apps and browsers, offers to save new ones). Only the system binds it. -->
        <service
            android:name=".vault.autofill.VaultAutofillService"
            android:exported="true"
            android:label="@string/vault_af_service"
            android:permission="android.permission.BIND_AUTOFILL_SERVICE">
            <intent-filter>
                <action android:name="android.service.autofill.AutofillService" />
            </intent-filter>
            <meta-data
                android:name="android.autofill"
                android:resource="@xml/vault_autofill_service" />
        </service>

        <!-- Vault: unlock / pick an entry / save a login for autofill. NOT
             exported: only the autofill service's own PendingIntents start it. -->
        <activity
            android:name=".vault.autofill.VaultAutofillActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:label="@string/vault_title"
            android:theme="@style/Theme.GateControl"
            android:windowSoftInputMode="adjustResize" />

        <!-- GateDrop: buttons of its notifications (Kopieren, Speichern).
             NOT exported: only the app's own PendingIntents reach it. -->
        <receiver
            android:name=".gatedrop.GateDropActionReceiver"
            android:exported="false" />

        <!-- GateDrop: WorkManager's foreground service carries the transfers
             (upload, download, direct LAN transfer) as data sync. -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.provider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
